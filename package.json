{
  "name": "sandbox-vortex-launcher",
  "version": "0.9.56",
  "description": "Sandbox Vortex Launcher with isolated Fabric instances and Cosmetics",
  "main": "src/main.js",
  "author": "Vortex Client",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vortexclient.sandbox",
    "productName": "Sandbox Vortex",
    "artifactName": "Sandbox Vortex Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Lukas3578",
      "repo": "vortex-launcher-sandbox",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "Sandbox Vortex"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "language": "1031",
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sandbox Vortex",
      "guid": "6A3703F6-6092-40C1-AD59-2DAEF4DAA19C",
      "uninstallerName": "Sandbox-Vortex-Uninstall.exe",
      "uninstallDisplayName": "Sandbox Vortex",
      "menuCategory": "Vortex Sandbox"
    }
  }
}
